{
	"name": "qwik-boilerplate",
	"version": "1.0.0",
	"description": "Minimalistic fullstack boilerplate for developing Qwik + QwikCity applications in TypeScript, optimized for blazing-fast performance using Bun & Vite 🚀",
	"author": "Raja Rakotonirina <raja.rakoto7@gmail.com>",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RajaRakoto/qwik-boilerplate.git"
	},
	"homepage": "https://github.com/RajaRakoto/qwik-boilerplate#readme",
	"bugs": "https://github.com/RajaRakoto/qwik-boilerplate/issues",
	"trustedDependencies-annotation": "Needed for bun to allow running install scripts",
	"trustedDependencies": [
		"sharp"
	],
	"engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime and React 18.2.0 or higher for integration with Qwik. Vite 7 requires Node ^20.19.0 || >=22.12.0",
	"engines": {
		"node": "^20.19.0 || >=22.12.0",
		"react": ">=18.2.0"
	},
	"keywords": [
		"typescript",
		"qwikjs",
		"qwik",
		"qwik-city",
		"vitejs",
		"vite",
		"bunjs",
		"bun",
		"minimalist",
		"fullstack",
		"boilerplate",
		"template",
		"starter"
	],
	"scripts": {
		"start": "vite --open --mode ssr",
		"preview": "qwik build preview && vite preview --open",
		"clean": "rimraf server build dist coverage playwright-report",
		"dev": "vite --mode ssr",
		"dev:debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"build": "qwik build",
		"build.client": "vite build",
		"build.preview": "vite build --ssr src/entry.preview.tsx",
		"build.types": "tsc --incremental --noEmit",
		"test:unit": "bun test ./tests/*.test.ts",
		"test:unit:watch": "bun test --watch ./tests/*.test.ts",
		"test:e2e": "rimraf playwright-report && playwright test ./e2e/*.spec.ts",
		"biome:start": "biome start",
		"biome:stop": "biome stop",
		"biome:fix": "biome check --fix .",
		"biome:unsafe": "biome check --fix --unsafe .",
		"eslint": "eslint --report-unused-disable-directives --max-warnings 0 .",
		"prettier": "prettier --config .prettierrc --write .",
		"backups": "grunt backups",
		"pkg-check": "depcheck",
		"pkg-upgrade": "ncu --interactive --format group --packageManager bun",
		"versioning": "ungit",
		"npm-version:major": "npm version major",
		"npm-version:minor": "npm version minor",
		"npm-version:patch": "npm version patch",
		"nvm": "nvm use",
		"script:sass-charset": "cd scripts && bun sass-charset.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@builder.io/partytown": "^0.10.3",
		"@eslint/js": "^10.0.1",
		"@builder.io/qwik": "^1.20.0",
		"@builder.io/qwik-city": "^1.20.0",
		"@fontsource-variable/overpass": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@qwikest/icons": "^0.0.13",
		"@tailwindcss/postcss": "^4.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "latest",
		"@types/node": "26.1.2",
		"@typescript-eslint/eslint-plugin": "8.66.0",
		"@typescript-eslint/parser": "8.66.0",
		"autoprefixer": "^10.5.4",
		"depcheck": "^1.4.7",
		"eslint": "10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-qwik": "^1.20.0",
		"globals": "^17.9.0",
		"grunt-cli": "^1.5.0",
		"grunt-contrib-compress": "^2.0.0",
		"load-grunt-tasks": "^5.1.0",
		"npm-check-updates": "^23.0.1",
		"playwright": "^1.62.1",
		"postcss": "^8.5.25",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rimraf": "^6.1.3",
		"sass": "1.77.6",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3",
		"undici": "*",
		"ungit": "^1.5.30",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^6.1.1"
	}
}
